    (add_net "NMI_TAMPER_TRIGGER")
  )

  ;; STREFA CHRONIONA ZASILANIA (ZONE / COPPER POUR)
  (zone (net 2) (net_name "GND") (layer "F.Cu")
    (hatch edge 0.5)
    (connect_pads (clearance 0.2))
    (min_thickness 0.15)
    (fill (thermal_gap 0.2) (thermal_bridge_width 0.3))
    (polygon
