  ;; KONFIGURACJA STOSU (STACKUP) DLA ELASTYCZNEJ NAKLEJKI PLOMBUJĄCEJ
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.0125))
      (layer "F.Cu" (type "copper") (thickness 0.018)) ; Cienka miedź dla elastyczności (1/2 oz)
      (layer "Dielectric 1" (type "core") (thickness 0.05) (material "Polyimide")) ; Baza FPC
      (layer "B.Cu" (type "copper") (thickness 0.018))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.0125))
    )
    (pad_to_mask_clearance 0.05)
    (pcb_thickness 0.098) ; Bardzo cienki profil (mikro) umożliwiający zgięcia
  )

  ;; KLASY SIECI (NET CLASSES) - RYGOR BEZPIECZEŃSTWA
  (net_class "Default" "To domyślna klasa dla logiki"
    (clearance 0.15)
    (trace_width 0.15)
    (via_dia 0.4)
    (via_drill 0.2)
  )
  
  (net_class "Power_Isolated" "Domena VCC_SAFE podtrzymywana przez nanokondensator"
